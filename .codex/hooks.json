{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 35,
            "statusMessage": "Connecting Portfolio Manager"
          }
        ]
      }
    ]
  }
}
