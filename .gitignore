# Codex Relay runtime belongs in %%LOCALAPPDATA%%/CodexRelay, never in Git.
__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
codex-relay.local/

# Installed dependencies and local artifact-tool junctions are not source.
node_modules/
.venv/

# Disposable native-review inputs, recalculation caches and application profiles.
outputs/**/qa/lo-profile/
outputs/**/qa/cases/
outputs/**/qa/case-results*/
outputs/**/qa/recalculated/
outputs/**/qa/*.xlsx

# Isolated publication checkout and nested disposable review state.
.tmp/
outputs/**/lo-profile/
outputs/**/qa/**/cases/
outputs/**/qa/**/recalculated/
