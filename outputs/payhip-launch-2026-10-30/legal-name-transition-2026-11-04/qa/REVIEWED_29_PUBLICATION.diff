+files={'Cleaning_Pricing_Calculator.xlsx':final/'customer/Cleaning_Pricing_Calculator.xlsx','Cleaning_Pricing_Calculator_FICTIONAL_DEMO.xlsx':final/'examples/Cleaning_Pricing_Calculator_FICTIONAL_DEMO.xlsx'}
